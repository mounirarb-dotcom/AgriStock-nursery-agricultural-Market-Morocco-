# ==============================================================================
# AgriStock Security & Environment Configuration (OWASP Compliance)
# Never commit real secrets or credentials to source control.
# ==============================================================================

# Server configuration
PORT="3000"
NODE_ENV="development"
APP_URL="http://localhost:3000"

# GEMINI_API_KEY: Required for Gemini AI API calls (if applicable)
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Firebase Client Configuration (Consumed via import.meta.env on frontend)
VITE_FIREBASE_API_KEY="MY_FIREBASE_API_KEY"
VITE_FIREBASE_AUTH_DOMAIN="MY_FIREBASE_AUTH_DOMAIN"
VITE_FIREBASE_PROJECT_ID="MY_FIREBASE_PROJECT_ID"
VITE_FIREBASE_DATABASE_ID="MY_FIREBASE_DATABASE_ID"
VITE_FIREBASE_STORAGE_BUCKET="MY_FIREBASE_STORAGE_BUCKET"
VITE_FIREBASE_MESSAGING_SENDER_ID="MY_FIREBASE_MESSAGING_SENDER_ID"
VITE_FIREBASE_APP_ID="MY_FIREBASE_APP_ID"
VITE_FIREBASE_OAUTH_CLIENT_ID="MY_FIREBASE_OAUTH_CLIENT_ID"

# CMI Payment Gateway (Paiements & Escrow B2B Maroc)
VITE_CMI_CLIENT_ID="MY_CMI_CLIENT_ID"
CMI_CLIENT_SECRET="MY_CMI_CLIENT_SECRET"
VITE_CMI_API_KEY="MY_CMI_API_KEY"

# Bourse Climat Maroc (Données agro-météo en temps réel)
VITE_BOURSE_CLIMAT_API_KEY="MY_BOURSE_CLIMAT_API_KEY"

# ONSSA Maroc (Certifications et contrôles phytosanitaires)
VITE_ONSSA_API_KEY="MY_ONSSA_API_KEY"

# Google Maps Platform (Cartographie interactive et géolocalisation agricole)
VITE_GOOGLE_MAPS_API_KEY="MY_GOOGLE_MAPS_API_KEY"

# Rate Limiting & Security Guards
RATE_LIMIT_WINDOW_MS="60000"
RATE_LIMIT_MAX_REQUESTS="60"
